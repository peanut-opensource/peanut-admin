#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

docker compose up -d mysql

for attempt in $(seq 1 60); do
  if php -r '
    try {
        new PDO(
            "mysql:host=127.0.0.1;port=" . (getenv("MYSQL_PORT") ?: "3306"),
            "root",
            getenv("MYSQL_ROOT_PASSWORD") ?: "peanut_admin_root_dev",
            [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION],
        );
    } catch (Throwable) {
        exit(1);
    }
  ' 2>/dev/null; then
    break
  fi

  if [[ "$attempt" -eq 60 ]]; then
    echo 'ERROR: MySQL 8 did not become ready for security tests' >&2
    exit 1
  fi
  sleep 2
done

junit_report="$(mktemp "${TMPDIR:-/tmp}/peanut-admin-security-junit.XXXXXX")"
trap 'rm -f "$junit_report"' EXIT
PEANUT_INTEGRATION=1 php vendor/bin/phpunit --log-junit "$junit_report" \
  packages/php/kernel/tests/Integration/Auth \
  packages/php/kernel/tests/Integration/Authorization \
  packages/php/kernel/tests/Integration/Idempotency \
  packages/php/kernel/tests/Integration/Module \
  packages/php/kernel/tests/Integration/Schema \
  packages/php/kernel/tests/Unit/Api \
  packages/php/kernel/tests/Unit/Authorization \
  packages/php/kernel/tests/Unit/Context \
  packages/php/kernel/tests/Unit/Idempotency \
  packages/php/kernel/tests/Unit/Module \
  packages/php/data-permission/tests/Integration \
  packages/php/data-permission/tests/Security \
  packages/php/data-permission/tests/Unit \
  backend/tests/Architecture \
  backend/tests/Contract \
  backend/tests/Security \
  tests/security

php -r '
$document = new DOMDocument();
if (!$document->load($argv[1])) {
    fwrite(STDERR, "ERROR: security JUnit report cannot be parsed\n");
    exit(1);
}
$skipped = $document->getElementsByTagName("skipped")->length;
if ($skipped !== 0) {
    fwrite(STDERR, "ERROR: security gate contains {$skipped} skipped test(s)\n");
    exit(1);
}
' "$junit_report"

if rg -n 'localStorage|sessionStorage' frontend/src packages/web; then
  echo 'ERROR: browser storage must not contain authentication tokens' >&2
  exit 1
fi

echo 'G-07 security qualification: OK (0 skipped)'
