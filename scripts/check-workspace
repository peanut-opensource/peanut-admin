#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

required=(
  composer.json
  composer.lock
  backend/composer.json
  frontend/package.json
  packages/php/kernel/composer.json
  packages/php/data-permission/composer.json
  packages/php/testing/composer.json
  packages/php/settings/composer.json
  packages/php/reference-codes/composer.json
  packages/php/file-media/composer.json
  packages/php/task-job/composer.json
  packages/php/notification-sms/composer.json
  packages/web/admin-core/package.json
  packages/web/admin-shell/package.json
  packages/web/settings/package.json
  packages/web/reference-codes/package.json
  packages/web/file-media/package.json
  packages/web/task-job/package.json
  packages/web/notification-sms/package.json
  packages/web/testing/package.json
  compose.yaml
  docs/decisions/dependencies/p0-a04-lock-evidence.json
  docs/decisions/dependencies/p1-b03-lock-evidence.json
  docs/decisions/dependencies/p1-b04-lock-evidence.json
  docs/decisions/dependencies/c02-file-media-lock-evidence.json
)

for path in "${required[@]}"; do
  if [[ ! -f "$path" ]]; then
    echo "ERROR: workspace file is missing: $path" >&2
    exit 1
  fi
done

composer_version="$(composer --version --no-ansi | sed -E 's/^Composer version ([0-9.]+).*/\1/')"
pnpm_version="$(pnpm --version)"
if [[ "$composer_version" != '2.10.2' ]]; then
  echo "ERROR: Composer 2.10.2 is required, found $composer_version" >&2
  exit 1
fi
if [[ "$pnpm_version" != '11.13.0' ]]; then
  echo "ERROR: pnpm 11.13.0 is required, found $pnpm_version" >&2
  exit 1
fi

php -r '
$evidence = json_decode(
    (string) file_get_contents("docs/decisions/dependencies/c02-file-media-lock-evidence.json"),
    true,
    512,
    JSON_THROW_ON_ERROR,
);
foreach ([
    "composer.lock",
    "pnpm-lock.yaml",
    "starter/backend/composer.lock",
    "starter/pnpm-lock.yaml",
] as $path) {
    $expected = $evidence["locks"][$path]["sha256"] ?? null;
    if (!is_string($expected) || hash_file("sha256", $path) !== $expected) {
        fwrite(STDERR, "ERROR: dependency lock evidence is stale for {$path}\n");
        exit(1);
    }
}
'

php -r '
$expectedPhp = [
    "packages/php/kernel/composer.json" => ["peanut-admin/kernel", "PeanutAdmin\\Kernel\\"],
    "packages/php/data-permission/composer.json" => ["peanut-admin/data-permission", "PeanutAdmin\\DataPermission\\"],
    "packages/php/testing/composer.json" => ["peanut-admin/testing", "PeanutAdmin\\Testing\\"],
    "packages/php/settings/composer.json" => ["peanut-admin/settings", "PeanutAdmin\\Settings\\"],
    "packages/php/reference-codes/composer.json" => ["peanut-admin/reference-codes", "PeanutAdmin\\ReferenceCodes\\"],
    "packages/php/file-media/composer.json" => ["peanut-admin/file-media", "PeanutAdmin\\FileMedia\\"],
    "packages/php/task-job/composer.json" => ["peanut-admin/task-job", "PeanutAdmin\\TaskJob\\"],
    "packages/php/notification-sms/composer.json" => ["peanut-admin/notification-sms", "PeanutAdmin\\NotificationSms\\"],
];
foreach ($expectedPhp as $path => [$name, $namespace]) {
    $manifest = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    if (($manifest["name"] ?? null) !== $name) {
        fwrite(STDERR, "ERROR: {$path} has the wrong package name\n");
        exit(1);
    }
    if (($manifest["license"] ?? null) !== "Apache-2.0") {
        fwrite(STDERR, "ERROR: {$path} must declare Apache-2.0\n");
        exit(1);
    }
    if (($manifest["autoload"]["psr-4"][$namespace] ?? null) !== "src/") {
        fwrite(STDERR, "ERROR: {$path} has the wrong PSR-4 public namespace\n");
        exit(1);
    }
}

$backend = json_decode((string) file_get_contents("backend/composer.json"), true, 512, JSON_THROW_ON_ERROR);
if (($backend["autoload"]["psr-4"]["PeanutAdmin\\App\\"] ?? null) !== "app/") {
    fwrite(STDERR, "ERROR: backend host namespace must map PeanutAdmin\\App\\ to app/\n");
    exit(1);
}
$settingsRepository = array_values(array_filter(
    $backend["repositories"] ?? [],
    static fn(mixed $repository): bool => is_array($repository)
        && ($repository["url"] ?? null) === "../packages/php/settings",
));
if (count($settingsRepository) !== 1 || ($settingsRepository[0]["type"] ?? null) !== "path") {
    fwrite(STDERR, "ERROR: backend must consume peanut-admin/settings from its workspace path repository\n");
    exit(1);
}
if (($backend["require"]["peanut-admin/settings"] ?? null) !== "^0.1.0") {
    fwrite(STDERR, "ERROR: backend must require peanut-admin/settings ^0.1.0\n");
    exit(1);
}
$referenceCodesRepository = array_values(array_filter(
    $backend["repositories"] ?? [],
    static fn(mixed $repository): bool => is_array($repository)
        && ($repository["url"] ?? null) === "../packages/php/reference-codes",
));
if (count($referenceCodesRepository) !== 1 || ($referenceCodesRepository[0]["type"] ?? null) !== "path") {
    fwrite(STDERR, "ERROR: backend must consume peanut-admin/reference-codes from its workspace path repository\n");
    exit(1);
}
if (($backend["require"]["peanut-admin/reference-codes"] ?? null) !== "^0.1.0") {
    fwrite(STDERR, "ERROR: backend must require peanut-admin/reference-codes ^0.1.0\n");
    exit(1);
}
$fileMediaRepository = array_values(array_filter(
    $backend["repositories"] ?? [],
    static fn(mixed $repository): bool => is_array($repository)
        && ($repository["url"] ?? null) === "../packages/php/file-media",
));
if (count($fileMediaRepository) !== 1 || ($fileMediaRepository[0]["type"] ?? null) !== "path") {
    fwrite(STDERR, "ERROR: backend must consume peanut-admin/file-media from its workspace path repository\n");
    exit(1);
}
if (($backend["require"]["peanut-admin/file-media"] ?? null) !== "^0.1.0") {
    fwrite(STDERR, "ERROR: backend must require peanut-admin/file-media ^0.1.0\n");
    exit(1);
}
foreach ([
    "task-job" => "peanut-admin/task-job",
    "notification-sms" => "peanut-admin/notification-sms",
] as $directory => $package) {
    $repositories = array_values(array_filter(
        $backend["repositories"] ?? [],
        static fn(mixed $repository): bool => is_array($repository)
            && ($repository["url"] ?? null) === "../packages/php/{$directory}",
    ));
    if (count($repositories) !== 1 || ($repositories[0]["type"] ?? null) !== "path") {
        fwrite(STDERR, "ERROR: backend must consume {$package} from its workspace path repository\n");
        exit(1);
    }
    if (($backend["require"][$package] ?? null) !== "^0.1.0") {
        fwrite(STDERR, "ERROR: backend must require {$package} ^0.1.0\n");
        exit(1);
    }
}

$expectedWeb = [
    "packages/web/admin-core/package.json" => "@peanut-admin/admin-core",
    "packages/web/admin-shell/package.json" => "@peanut-admin/admin-shell",
    "packages/web/settings/package.json" => "@peanut-admin/settings",
    "packages/web/reference-codes/package.json" => "@peanut-admin/reference-codes",
    "packages/web/file-media/package.json" => "@peanut-admin/file-media",
    "packages/web/task-job/package.json" => "@peanut-admin/task-job",
    "packages/web/notification-sms/package.json" => "@peanut-admin/notification-sms",
    "packages/web/testing/package.json" => "@peanut-admin/web-testing",
];
foreach ($expectedWeb as $path => $name) {
    $manifest = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    if (($manifest["name"] ?? null) !== $name || ($manifest["license"] ?? null) !== "Apache-2.0") {
        fwrite(STDERR, "ERROR: {$path} has an invalid name or license\n");
        exit(1);
    }
    if (!isset($manifest["exports"]["."])) {
        fwrite(STDERR, "ERROR: {$path} must expose one public root export\n");
        exit(1);
    }
}
'

approved_license_hash="cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30"
for package_license in packages/php/*/LICENSE packages/web/*/LICENSE; do
  actual="$(php -r 'echo hash_file("sha256", $argv[1]);' "$package_license")"
  if [[ "$actual" != "$approved_license_hash" ]]; then
    echo "ERROR: package license does not match Apache-2.0 baseline: $package_license" >&2
    exit 1
  fi
done

composer validate --strict --no-check-publish
php vendor/bin/phpunit
php vendor/bin/phpstan analyse --no-progress --memory-limit=512M
php vendor/bin/deptrac analyse --no-progress --fail-on-uncovered --cache-file=.cache/deptrac.cache
php vendor/bin/php-cs-fixer check --diff --config=scripts/php-cs-fixer.php

pnpm lint
pnpm typecheck
pnpm test:unit
pnpm build

docker compose config --quiet

echo 'Workspace skeleton: OK'
