#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "$#" -ne 1 ]]; then
  echo 'Usage: ./scripts/create-internal-starter <empty-target-directory>' >&2
  exit 64
fi

target="$1"
if [[ -e "$target" ]] && [[ ! -d "$target" ]]; then
  echo "ERROR: starter target is not a directory: $target" >&2
  exit 1
fi
if [[ -d "$target" ]] && [[ -n "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
  echo "ERROR: starter target must be empty: $target" >&2
  exit 1
fi

mkdir -p "$target"
cp -R "$ROOT/starter/." "$target/"

copy_package() {
  local source="$1"
  local destination="$2"
  local manifest="$3"

  mkdir -p "$destination"
  cp "$source/$manifest" "$destination/$manifest"
  cp "$source/LICENSE" "$destination/LICENSE"
  cp -R "$source/src" "$destination/src"
  for directory in database resources; do
    if [[ -d "$source/$directory" ]]; then
      cp -R "$source/$directory" "$destination/$directory"
    fi
  done
}

copy_package "$ROOT/packages/php/kernel" "$target/packages/php/kernel" composer.json
copy_package "$ROOT/packages/php/data-permission" "$target/packages/php/data-permission" composer.json
copy_package "$ROOT/packages/web/admin-core" "$target/packages/web/admin-core" package.json
copy_package "$ROOT/packages/web/admin-shell" "$target/packages/web/admin-shell" package.json

echo "Internal starter created at: $target"
