{
  "name": "peanut-admin/backend",
  "description": "Peanut Admin Backend API",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1",
    "topthink/framework": "^8.1.4",
    "firebase/php-jwt": "^6.10",
    "topthink/think-helper": "^3.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app/"
    },
    "files": [
      "app/common.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {}
  }
}
