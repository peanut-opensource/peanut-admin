{
  "name": "peanut-admin/internal-starter-backend",
  "description": "Fixed internal ThinkPHP host for Peanut Admin package verification",
  "type": "project",
  "license": "Apache-2.0",
  "repositories": [
    {
      "type": "path",
      "url": "../packages/php/kernel",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../packages/php/data-permission",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../packages/php/settings",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../packages/php/reference-codes",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../packages/php/file-media",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "composer/semver": "3.4.4",
    "opis/json-schema": "2.6.0",
    "php": "^8.3",
    "peanut-admin/data-permission": "0.1.0",
    "peanut-admin/kernel": "0.1.0",
    "peanut-admin/file-media": "0.1.0",
    "peanut-admin/reference-codes": "0.1.0",
    "peanut-admin/settings": "0.1.0",
    "topthink/framework": "8.1.4",
    "topthink/think-migration": "3.1.1"
  },
  "autoload": {
    "psr-4": {
      "ExampleHost\\App\\Modules\\": "src/Modules/",
      "PeanutAdmin\\InternalStarter\\": "src/"
    },
    "exclude-from-classmap": [
      "src/Modules/Peanut/Settings/Database/Migrations/",
      "src/Modules/Peanut/ReferenceCodes/Database/Migrations/",
      "src/Modules/Peanut/FileMedia/Database/Migrations/"
    ]
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.24"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
