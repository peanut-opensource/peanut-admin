{
  "name": "peanut-admin/internal-starter-backend",
  "description": "Fixed internal ThinkPHP host for Peanut Admin package verification",
  "type": "project",
  "license": "Apache-2.0",
  "repositories": [
    {
      "type": "path",
      "url": "../packages/php/kernel",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../packages/php/data-permission",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "php": "^8.3",
    "peanut-admin/data-permission": "0.1.0",
    "peanut-admin/kernel": "0.1.0",
    "topthink/framework": "8.1.4"
  },
  "autoload": {
    "psr-4": {
      "PeanutAdmin\\InternalStarter\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.24"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
